{
  "name": "piano-fundamentals-trainer",
  "version": "1.0.0-rc.1",
  "description": "钢琴基本功训练器：MIDI 输入、节拍器及五个基本功练习模块。",
  "productName": "钢琴基本功训练器",
  "author": "Piano Fundamentals Trainer",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "prototype:android": "vite --config vite.android-prototype.config.ts --host 0.0.0.0",
    "build:prototype:android": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && vite build --config vite.android-prototype.config.ts",
    "build:android:debug": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && vite build --mode android-debug --config vite.android-prototype.config.ts",
    "build:android:qa": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && vite build --mode android-qa --config vite.android-prototype.config.ts",
    "build:android:release": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && vite build --mode android-release --config vite.android-prototype.config.ts",
    "android:sync": "npm run build:android:debug && cap sync android",
    "android:sync:qa": "npm run build:android:qa && cap sync android",
    "android:sync:release": "npm run build:android:release && cap sync android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:apk:qa": "npm run android:sync:qa && cd android && gradlew.bat assembleQa",
    "android:apk:release": "npm run android:sync:release && cd android && gradlew.bat assembleRelease",
    "android:verify:debug": "node scripts/android-apk-signing-report.cjs android/app/build/outputs/apk/debug/app-debug.apk --expect-debug",
    "android:verify:qa": "node scripts/android-apk-signing-report.cjs android/app/build/outputs/apk/qa/app-qa.apk --expect-debug --expected-application-id=com.pianofundamentals.trainer.qa",
    "android:verify:release": "node scripts/android-apk-signing-report.cjs android/app/build/outputs/apk/release/app-release.apk --expect-release",
    "diagnose:piano-latency": "electron scripts/measure-piano-latency.cjs",
    "poc:native-audio:build": "cmake -S native-audio-poc -B native-audio-poc/build -A x64 && cmake --build native-audio-poc/build --config Release",
    "poc:native-audio:auto": "electron scripts/native-audio-poc.cjs",
    "test:regression": "node scripts/regression-check.cjs",
    "test:sight-reading": "tsc --noEmit -p tsconfig.sight-reading.json && node scripts/sight-reading-contracts.cjs",
    "test:android-integration": "node scripts/android-sight-reading-integration.cjs",
    "test:android-bluetooth-midi": "node scripts/android-bluetooth-midi-check.cjs",
    "test:android-bluetooth-midi:native": "cd android && gradlew.bat testDebugUnitTest --tests com.pianofundamentals.trainer.BluetoothMidiStatePolicyTest",
    "test:android-signing": "node scripts/android-signing-foundation-check.cjs",
    "test:android-release-mode": "node scripts/android-release-mode-check.cjs",
    "test:android-persistence": "node scripts/android-persistence-check.cjs",
    "test:android-history": "node scripts/android-history-check.cjs",
    "test:android-updater": "node scripts/android-updater-check.cjs",
    "test:android-updater:native": "node scripts/android-updater-native-check.cjs",
    "test:android-updater:network": "node scripts/android-native-manifest-network-check.cjs",
    "test:android-double-note": "node scripts/android-double-note-check.cjs",
    "test:android-icon": "node scripts/android-icon-check.cjs",
    "test:android-chord-ui": "node scripts/android-chord-static-ui-check.cjs",
    "test:android-chord-theory": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-chord-theory-check.cjs",
    "test:android-chord-judgement": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-chord-judgement-check.cjs",
    "test:android-chord-runtime": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-chord-runtime-check.cjs",
    "test:android-chord-sequential": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-chord-sequential-check.cjs",
    "test:android-chord-persistence": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-chord-persistence-check.cjs",
    "test:android-chord-report-detail": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-chord-report-detail-check.cjs",
    "test:android-scale-key-signature-tool": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-scale-key-signature-tool-check.cjs",
    "test:android-active-practice-session": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-active-practice-session-check.cjs",
    "test:android-practice-keep-awake": "tsc --noEmit -p prototype/android-tablet-v1/tsconfig.json && node scripts/android-practice-keep-awake-check.cjs",
    "test:android-navigation-ia": "node scripts/android-navigation-ia-check.cjs",
    "test:android-qa-channel": "node scripts/android-qa-channel-check.cjs",
    "test:android-shell": "node scripts/android-shell-check.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/preferences": "8.0.1",
    "@vexflow-fonts/bravura": "1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "rcedit": "^5.0.2",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.piano.fundamentals.trainer",
    "productName": "钢琴基本功训练器",
    "copyright": "Copyright © 2026 Piano Fundamentals Trainer",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/piano-samples",
        "to": "piano-samples",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "钢琴基本功训练器",
      "uninstallDisplayName": "钢琴基本功训练器 ${version}",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
