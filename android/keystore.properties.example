# Copy this file to android/keystore.properties and fill it in locally.
# android/keystore.properties is gitignored. Never commit its values.
# Use forward slashes in Windows paths because Java Properties treats backslashes as escapes.
storeFile=C:/Users/YOUR_ACCOUNT/.android-signing/piano-fundamentals-release.jks
storePassword=
keyAlias=piano-fundamentals
keyPassword=
